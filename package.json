{
  "name": "maple",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@maple/eslint-config": "workspace:*",
    "eslint": "^9.0.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4"
  }
}
